{
  "manifest_version": 3,
  "name": "YouTube Adaptive Ad Controller",
  "version": "2.2.4",
  "description": "Adds visible skip-button retries and experimental adaptive ad playback speed up to 256\u00d7.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube Adaptive Ad Controller",
    "default_popup": "popup.html"
  }
}
