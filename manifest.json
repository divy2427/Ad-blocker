{
  "manifest_version": 3,
  "name": "Music Ad Helper",
  "version": "0.3.0",
  "description": "Experiment with YouTube Music playback and ad detection.",
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Music Ad Helper",
    "default_popup": "popup.html"
  }
}
