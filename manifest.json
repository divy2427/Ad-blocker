{
  "manifest_version": 3,
  "name": "Music Ad Helper",
  "version": "1.0.0",
  "description": "Detect YouTube Music ads and click available Skip controls.",
  "permissions": [],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Music Ad Helper",
    "default_popup": "popup.html"
  }
}
